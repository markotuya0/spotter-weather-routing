# Copy to .env and fill in real values. .env is git-ignored — never commit real keys.

# TomTom Developer Portal: https://developer.tomtom.com/ (free tier, no credit card)
TOMTOM_API_KEY=

# Only needed if Gate 0 forces a fallback from TomTom to HERE (docs/08-execution-plan.md §4)
HERE_API_KEY=

# --- Deployment config (M2 security closeout, docs/09-decisions.md) ---
# DEBUG defaults to 0 (off). Set DEBUG=1 for local dev only — never in production.
DEBUG=1

# ALLOWED_HOSTS defaults to localhost,127.0.0.1 (never "*"). Production (Render)
# MUST set this explicitly to the deployed hostname(s), comma-separated.
ALLOWED_HOSTS=localhost,127.0.0.1

# Number of trusted reverse-proxy hops in front of the app, for safely parsing
# X-Forwarded-For when throttling by client identity (docs/09-decisions.md W-2
# ASSUMPTION: 1 hop, matching Render's standard single edge load balancer).
NUM_PROXIES=1
